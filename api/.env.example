# WhatsApp Cloud API Credentials (Meta Graph API v21.0)
# Note: Temporary access tokens from the Meta App Dashboard expire in 24 hours.
WHATSAPP_TOKEN=EAAG...your_meta_whatsapp_access_token_here

# Meta Phone Number ID (from WhatsApp > API Setup in Meta dashboard)
WHATSAPP_PHONE_NUMBER_ID=100000000000000

# Recipient Phone Number (include country code without '+', e.g. 919876543210)
# Note: For Meta test accounts, this number MUST be allow-listed in the Meta dashboard.
WHATSAPP_RECIPIENT_PHONE_NUMBER=919876543210

# Optional template configuration (defaults to 'hello_world' and 'en_US' if unset)
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
